# ─── LLM / Embedding Provider ─────────────────────────────────────────────────
# Primary: Google Gemini (free tier available)
GOOGLE_API_KEY=your_google_api_key_here

# Optional: OpenAI fallback
OPENAI_API_KEY=

# ─── Application ──────────────────────────────────────────────────────────────
APP_ENV=development          # development | production
SECRET_KEY=change-me-in-prod
CORS_ORIGINS=http://localhost:3000

# ─── Database ─────────────────────────────────────────────────────────────────
DATABASE_URL=sqlite:///./studycompanion.db
# PostgreSQL example:
# DATABASE_URL=postgresql://user:password@localhost:5432/studycompanion

# ─── Vector Store ─────────────────────────────────────────────────────────────
CHROMA_PERSIST_DIR=./chroma_db

# ─── File Storage ─────────────────────────────────────────────────────────────
UPLOAD_DIR=./data/uploads
MAX_UPLOAD_MB=500

# ─── Whisper ASR ──────────────────────────────────────────────────────────────
WHISPER_MODEL=small        # tiny | base | small | medium | large
WHISPER_DEVICE=cpu         # cpu | cuda

# ─── Ingestion ────────────────────────────────────────────────────────────────
CHUNK_SIZE_TOKENS=400
CHUNK_OVERLAP_TOKENS=50
KEYFRAME_INTERVAL_SEC=30   # extract a keyframe every N seconds from video

# ─── RAG ──────────────────────────────────────────────────────────────────────
RETRIEVAL_TOP_K=20
RERANK_TOP_K=5
RELEVANCE_THRESHOLD=0.35   # below this → refusal

# ─── Learner Model ────────────────────────────────────────────────────────────
BKT_TRANSIT=0.10
BKT_SLIP_DEFAULT=0.10
BKT_GUESS_DEFAULT=0.25
BKT_PRIOR_DEFAULT=0.30

# ─── Redis (optional, for Celery) ─────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0
USE_CELERY=false          # set true when Redis is available
